th=\"20\" height=\"20\"><circle r=\"2\" cx=\"10\" cy=\"10\"></circle><circle r=\"2\" cx=\"5\" cy=\"5\"></circle><circle r=\"2\" cx=\"15\" cy=\"15\"></circle></svg></div></td><td><div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"5\" cy=\"4\"></circle><circle r=\"2\" cx=\"5\" cy=\"10\"></circle><circle r=\"2\" cx=\"5\" cy=\"16\"></circle><circle r=\"2\" cx=\"15\" cy=\"4\"></circle><circle r=\"2\" cx=\"15\" cy=\"10\"></circle><circle r=\"2\" cx=\"15\" cy=\"16\"></circle></svg></div> <div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"10\" cy=\"10\"></circle><circle r=\"2\" cx=\"5\" cy=\"5\"></circle><circle r=\"2\" cx=\"15\" cy=\"15\"></circle></svg></div></td><td colspan=\"3\"></td></tr><tr><td colspan=\"4\"></td><td><div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"10\" cy=\"10\"></circle><circle r=\"2\" cx=\"5\" cy=\"5\"></circle><circle r=\"2\" cx=\"5\" cy=\"15\"></circle><circle r=\"2\" cx=\"15\" cy=\"5\"></circle><circle r=\"2\" cx=\"15\" cy=\"15\"></circle></svg></div> <div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"10\" cy=\"10\"></circle></svg></div></td><td><div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"10\" cy=\"10\"></circle><circle r=\"2\" cx=\"5\" cy=\"5\"></circle><circle r=\"2\" cx=\"5\" cy=\"15\"></circle><circle r=\"2\" cx=\"15\" cy=\"5\"></circle><circle r=\"2\" cx=\"15\" cy=\"15\"></circle></svg></div> <div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"5\" cy=\"5\"></circle><circle r=\"2\" cx=\"15\" cy=\"15\"></circle></svg></div></td><td><div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"5\" cy=\"4\"></circle><circle r=\"2\" cx=\"5\" cy=\"10\"></circle><circle r=\"2\" cx=\"5\" cy=\"16\"></circle><circle r=\"2\" cx=\"15\" cy=\"4\"></circle><circle r=\"2\" cx=\"15\" cy=\"10\"></circle><circle r=\"2\" cx=\"15\" cy=\"16\"></circle></svg></div> <div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"5\" cy=\"5\"></circle><circle r=\"2\" cx=\"15\" cy=\"15\"></circle></svg></div></td><td colspan=\"4\"></td></tr><tr><td colspan=\"5\"></td><td><div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"5\" cy=\"4\"></circle><circle r=\"2\" cx=\"5\" cy=\"10\"></circle><circle r=\"2\" cx=\"5\" cy=\"16\"></circle><circle r=\"2\" cx=\"15\" cy=\"4\"></circle><circle r=\"2\" cx=\"15\" cy=\"10\"></circle><circle r=\"2\" cx=\"15\" cy=\"16\"></circle></svg></div> <div class=\"dice\"><svg width=\"20\" height=\"20\"><circle r=\"2\" cx=\"10\" cy=\"10\"></circle></svg></div></td><td colspan=\"5\"></td></tr></tbody></table></x-step>","goals":[],"keywords":[]},"analyse-tableau":{"id":"analyse-tableau","title":"Analyse Tableau","html":"<x-step id=\"analyse-tableau\" goals=\"blank-0 blank-1\"><h2>Analyse du tableau</h2><p>En comptant dans le tableau :</p><ul> <li>La somme la plus probable est <span class=\"dice outline\">7</span> avec <x-blank solution=\"6\" goal=\"blank-0\"></x-blank> façons de l'obtenir.</li><li>Les sommes les moins probables sont <span class=\"dice outline\">2</span> et <span class=\"dice outline\">12</span> avec <x-blank solution=\"1\" goal=\"blank-1\"></x-blank> seule façon chacune.</li></ul> <p>Il y a <strong>36</strong> combinaisons possibles au total (6 × 6).</p><p>Donc : <span class=\"math\" data-voice=\"P of obtenir 7 equals 6 over 36 equals 1 over 6 ≈ 0.167\"><mi>P</mi><mfenced><mtext>obtenir 7</mtext></mfenced><mo value=\"=\">=</mo><mfrac><mn>6</mn><mn>36</mn></mfrac><mo value=\"=\">=</mo><mfrac><mn>1</mn><mn>6</mn></mfrac><mo value=\"≈\">≈</mo><mn>0.167</mn></span></p><p>Et : <span class=\"math\" data-voice=\"P of obtenir 2 equals 1 over 36 ≈ 0.028\"><mi>P</mi><mfenced><mtext>obtenir 2</mtext></mfenced><mo value=\"=\">=</mo><mfrac><mn>1</mn><mn>36</mn></mfrac><mo value=\"≈\">≈</mo><mn>0.028</mn></span></p></x-step>","goals":["blank-0","blank-1"],"keywords":[]},"simulation":{"id":"simulation","title":"Simulation","html":"<x-step id=\"simulation\" goals=\"\"><h2>L'approche fréquentiste</h2><p>On peut <strong>estimer</strong> une probabilité en répétant une expérience aléatoire un grand nombre de fois et en calculant la <strong>fréquence</strong> de l'événement.</p><p class=\"text-center\"> <span class=\"math\" data-voice=\"Fréquence equals Nombre de fois où l'événement se réalise over Nombre total d'expériences\"><mtext>Fréquence</mtext><mo value=\"=\">=</mo><mfrac><mtext>Nombre de fois où l'événement se réalise</mtext><mtext>Nombre total d'expériences</mtext></mfrac></span></p></x-step>","goals":[],"keywords":[]},"dice-simulation":{"id":"dice-simulation","title":"Simulation de lancers de dés","html":"<x-step id=\"dice-simulation\" goals=\"roll var-0\"><h2>Simulation interactive</h2><p>Lance des dés virtuels et observe comment les fréquences se rapprochent des probabilités théoriques :</p><div class=\"box red with-title\"> <h3>Lancer de dés</h3><div class=\"probTable var\" :html=\"probTable(d)\"></div><p>Nous lançons <x-var bind=\"d|2|1,6,1\" goal=\"var-0\">${d}</x-var> dé(s) en même temps et enregistrons la <span class=\"dice\" style=\"width: auto; padding: 0 4px;\"> SOMME</span> des scores. Les <strong class=\"m-green\"> lignes vertes</strong> représentent les probabilités théoriques et les <strong class=\"m-blue\"> barres bleues</strong> montrent les fréquences observées.</p><p class=\"btn-row no-voice\"><button class=\"btn\">Lancer 1 fois</button><button class=\"btn\">Lancer 100 fois</button><button class=\"btn\">Lancer 1000 fois</button></p></div> <p class=\"reveal\" data-when=\"roll\"> Observe : plus on lance de fois, plus les fréquences (barres bleues) se rapprochent des probabilités théoriques (lignes vertes).</p><p class=\"reveal\" data-when=\"roll\"> C'est la <strong>loi des grands nombres</strong> : en répétant une expérience un grand nombre de fois, la fréquence observée se rapproche de la probabilité théorique.</p></x-step>","goals":["roll","var-0"],"keywords":[]},"arbres":{"id":"arbres","title":"Arbres","html":"<x-step id=\"arbres\" goals=\"\"><h2>Représenter avec un arbre</h2><p>Un <strong>arbre de probabilités</strong> permet de représenter toutes les issues d'une expérience aléatoire.</p><p><strong>Exemple :</strong> On lance une pièce deux fois de suite.</p><div class=\"row padded\"><div style=\"width: 300px\"> </div><div class=\"grow\"> <p>Les issues possibles sont :</p><ul> <li>Pile puis Pile (PP)</li><li>Pile puis Face (PF)</li><li>Face puis Pile (FP)</li><li>Face puis Face (FF)</li></ul> <p>Chaque issue a une probabilité de <span class=\"math\" data-voice=\"1 over 2 times 1 over 2 equals 1 over 4\"><mfrac><mn>1</mn><mn>2</mn></mfrac><mo value=\"×\">×</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo value=\"=\">=</mo><mfrac><mn>1</mn><mn>4</mn></mfrac></span></p></div></div> </x-step>","goals":[],"keywords":[]},"arbre-exercice":{"id":"arbre-exercice","title":"Arbre Exercice","html":"<x-step id=\"arbre-exercice\" goals=\"blank-0 blank-1 blank-2\"><h2>Exercice</h2><p>On lance une pièce deux fois. Quelle est la probabilité d'obtenir exactement une fois pile ?</p><ul> <li>Issues favorables : PF et FP → <x-blank solution=\"2\" goal=\"blank-0\"></x-blank> issues</li><li>Nombre total d'issues : <x-blank solution=\"4\" goal=\"blank-1\"></x-blank></li><li>Probabilité : <span class=\"math\" data-voice=\"2 over 4 equals\"><mfrac><mn>2</mn><mn>4</mn></mfrac><mo value=\"=\">=</mo></span> <x-blank solution=\"0.5\" goal=\"blank-2\"></x-blank></li></ul> </x-step>","goals":["blank-0","blank-1","blank-2"],"keywords":[]},"resume":{"id":"resume","title":"Resume","html":"<x-step id=\"resume\" goals=\"\"><h2>Ce qu'il faut retenir</h2><div class=\"box blue with-title\"> <h3>Vocabulaire</h3><ul> <li><strong>Expérience aléatoire</strong> : expérience dont le résultat dépend du hasard</li><li><strong>Issue</strong> : résultat possible d'une expérience</li><li><strong>Événement</strong> : ensemble d'issues</li><li><strong>Équiprobabilité</strong> : toutes les issues ont la même probabilité</li></ul> </div> <div class=\"box green with-title\"> <h3>Calcul de probabilité</h3><p class=\"text-center\"> <span class=\"math\"></span></p><ul> <li>La probabilité est toujours comprise entre <strong>0</strong> et <strong>1</strong></li><li>Probabilité 0 = événement impossible</li><li>Probabilité 1 = événement certain</li><li>Probabilité 0.5 = une chance sur deux</li></ul> </div> <div class=\"box red with-title\"> <h3>Loi des grands nombres</h3><p>Plus on répète une expérience, plus la fréquence observée se rapproche de la probabilité théorique.</p></div> </x-step>","goals":[],"keywords":[]}},"availableLocales":["fr"],"biosJSON":"{}","glossJSON":"{}","hintsJSON":"{\"welcome\":\"<p>Bienvenue chez Mathigon ! Je suis Archie, ton tuteur personnel. <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/graduation-cap.png\\\" alt=\\\"graduation-cap\\\"></p>\",\"account\":\"<p>Vous pouvez créer un compte gratuit pour enregistrer vos progrès.</p>\",\"tutorial1\":\"<p>Notre contenu est divisé en petites étapes. Vous devez compléter les activités pour révéler la suite.</p>\",\"tutorial2\":\"<p>Nous enregistrerons tous vos progrès afin que vous puissiez revenir plus tard et continuer là où vous l'avez laissé.</p>\",\"correct\":[\"<p>Bien joué <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/smiling-face.png\\\" alt=\\\"smiling-face\\\"></p>\",\"<p>Bon travail ! <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/relieved-face.png\\\" alt=\\\"relieved-face\\\"></p>\",\"<p>Brilliant <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/thumbs-up.png\\\" alt=\\\"thumbs-up\\\"></p>\",\"<p>Excellent ! <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/ok-hand.png\\\" alt=\\\"ok-hand\\\"></p>\",\"<p>Cool <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/smiling-face-with-sunglasses.png\\\" alt=\\\"smiling-face-with-sunglasses\\\"></p>\",\"<p>Agréable ! <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/victory-hand.png\\\" alt=\\\"victory-hand\\\"></p>\",\"<p>Marche à suivre ! <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/smiling-face-with-smiling-eyes.png\\\" alt=\\\"smiling-face-with-smiling-eyes\\\"></p>\",\"<p>Exceptionnel <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/grinning-face.png\\\" alt=\\\"grinning-face\\\"></p>\",\"<p>Superbe ! <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/star.png\\\" alt=\\\"star\\\"></p>\",\"<p>Merveilleux ! <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/smiling-face.png\\\" alt=\\\"smiling-face\\\"></p>\"],\"incorrect\":[\"<p>Ce n'est pas tout à fait juste <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/frowning-face.png\\\" alt=\\\"frowning-face\\\"></p>\",\"<p>Êtes-vous sûr de cela ? <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/thinking-face.png\\\" alt=\\\"thinking-face\\\"></p>\",\"<p>Cela ne semble pas juste. <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/hushed-face.png\\\" alt=\\\"hushed-face\\\"></p>\",\"<p>Réessayez ! <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/confused-face.png\\\" alt=\\\"confused-face\\\"></p>\"],\"welcomeMorning\":\"<p>Bonjour !</p>\",\"welcomeAfternoon\":\"<p>Bonjour !</p>\",\"welcomeEvening\":\"<p>Bonsoir !</p>\",\"welcomeMorningNamed\":\"<p>Bonjour, $name !</p>\",\"welcomeAfternoonNamed\":\"<p>Bonjour, $name !</p>\",\"welcomeEveningNamed\":\"<p>Bonsoir, $name !</p>\",\"serverError\":\"<p>Désolé, je ne peux pas aider pour le moment. Vérifiez votre connexion Internet ou réessayez plus tard. <img class=\\\"emoji\\\" width=\\\"20\\\" height=\\\"20\\\" src=\\\"https://static.mathigon.org/emoji/confused-face.png\\\" alt=\\\"confused-face\\\"></p>\"}"}